# ---------------------------------------------------------------------------
# MSPA driver makefile - Linux x86_64 (64 bit)
#
# Do not run this makefile directly: use ./deploy.sh Linux, which builds the
# static library libmiallib_mspa.a (in mial-master/core/c) first.
#
# CPU portability: no -march / -march=native is used. The binary therefore
# runs on any x86_64 CPU, Intel or AMD. -mtune=generic only affects
# instruction scheduling and does not enable CPU specific instructions.
# ---------------------------------------------------------------------------

OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

MIALINC = mial-master/core/c

CC = gcc

CFLAGS = -std=c99 -O2 -m64 -mtune=generic -Wall -fopenmp \
         -DFSP -DOPENMP -DNO_BUF -I$(MIALINC)

LDFLAGS = -O2 -fopenmp -static-libgcc -s

# Libraries are listed from the highest to the lowest level so that the
# static linker can resolve every symbol (a library must follow the
# libraries that use it).
LDLIBS = -Wl,--whole-archive libmiallib_mspa.a -Wl,--no-whole-archive \
         -Wl,-Bstatic \
         -ltiff -lpng -lwebp -ljpeg -ljbig -lLerc -lsharpyuv \
         -ldeflate -lz -lzstd -llzma -lgomp -lstdc++ \
         -Wl,-Bdynamic \
         -lpthread -lm -ldl -lc

fsp: $(OBJ_FSP) libmiallib_mspa.a
	$(CC) $(LDFLAGS) -o fsp $(OBJ_FSP) $(LDLIBS)
	cp fsp mspa_linux

MIALINC = mial-master/core/c

%.o: %.c $(MIALINC)/miallib.h $(MIALINC)/mialtypes.h \
       $(MIALINC)/config_miallib.h $(MIALINC)/op.h mia_parse.h frag.h
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	-rm -f *.o fsp mspa_linux

.PHONY: clean
