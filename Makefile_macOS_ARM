
OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

CC = gcc-16
# Removed -m64 (not needed on native ARM64) and fixed the include path to /opt/homebrew/include
CFLAGS = -std=c99 -O2 -Wall -fopenmp -DFSP -DOPENMP -DLIIAR -DLIBPROJ -DTESTING -DTEST2 -DEERIE -DUNIX -DMARCIN -DDISK_WRITE -w -I/opt/homebrew/include

OUTPUT_BIN = mspa_macOS_ARM

# Updated all static libraries to use the ARM Homebrew paths (/opt/homebrew)
STATIC_LIBS = \
	/opt/homebrew/opt/libtiff/lib/libtiff.a \
	/opt/homebrew/opt/zstd/lib/libzstd.a \
	/opt/homebrew/opt/xz/lib/liblzma.a \
	/opt/homebrew/opt/libpng/lib/libpng.a \
	/opt/homebrew/opt/jpeg-turbo/lib/libjpeg.a \
	/opt/homebrew/opt/jbigkit/lib/libjbig.a \
	/opt/homebrew/opt/webp/lib/libwebp.a \
	/opt/homebrew/opt/webp/lib/libsharpyuv.a \
	/opt/homebrew/Cellar/gcc/16.2.0/lib/gcc/current/libgomp.a

fsp: $(OBJ_FSP) libmiallib_mspa.a
	# Updated include library path to -L/opt/homebrew/lib
	$(CC) -O2 -fopenmp -static-libgcc -o fsp $(OBJ_FSP) \
		-Wl,-force_load,libmiallib_mspa.a \
		-L/opt/homebrew/lib \
		$(STATIC_LIBS) \
		-ldeflate -llerc -lgsl -lgslcblas -lz -lstdc++ -lpthread -lm -ldl
	strip fsp
	cp fsp $(OUTPUT_BIN)

%.o: %.c miallib.h
	$(COMPILE.c) -o $@ $<

clean:
	rm -f *.o fsp mspa_macOS_ARM
