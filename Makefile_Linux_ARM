# ---------------------------------------------------------------------------
# MSPA driver makefile - Linux aarch64 / ARM64 (64 bit)
#
# Do not run this makefile directly: use ./deploy.sh Linux_ARM, which builds
# the static library libmiallib_mspa.a (in mial-master/core/c) first.
#
# CPU portability: no -march / -march=native is used, so the binary runs on
# any ARMv8-A (aarch64) CPU. The compiler default already targets the
# baseline architecture of the distribution.
# ---------------------------------------------------------------------------

OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

MIALINC = mial-master/core/c

CC = gcc

CFLAGS = -std=c99 -O2 -Wall -fopenmp \
         -DFSP -DOPENMP -DNO_BUF -I$(MIALINC)

LDFLAGS = -O2 -fopenmp -static-libgcc -s

LDLIBS = -Wl,--whole-archive libmiallib_mspa.a -Wl,--no-whole-archive \
         -Wl,-Bstatic \
         -ltiff -lpng -lwebp -ljpeg -ljbig -lLerc -lsharpyuv \
         -ldeflate -lz -lzstd -llzma -lgomp -lstdc++ \
         -Wl,-Bdynamic \
         -lpthread -lm -ldl -lc

fsp: $(OBJ_FSP) libmiallib_mspa.a
	$(CC) $(LDFLAGS) -o fsp $(OBJ_FSP) $(LDLIBS)
	cp fsp mspa_linux_ARM

MIALINC = mial-master/core/c

%.o: %.c $(MIALINC)/miallib.h $(MIALINC)/mialtypes.h \
       $(MIALINC)/config_miallib.h $(MIALINC)/op.h mia_parse.h frag.h
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	-rm -f *.o fsp mspa_linux_ARM

.PHONY: clean
