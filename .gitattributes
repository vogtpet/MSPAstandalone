# Keep shell scripts and makefiles in LF form on every platform. This matters
# for the MSYS2/Windows CI jobs: a CRLF checkout breaks bash and make.
* text=auto eol=lf

# Windows batch files are parsed more reliably with CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

*.docx binary
*.tif binary
*.tiff binary
*.png binary
*.xcf binary
*.exe binary
*.dll binary
*.dylib binary
*.a binary
