
OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

CC = gcc-16
CFLAGS = -std=c99 -m64 -O2 -Wall -fopenmp -DFSP -DOPENMP -DLIIAR -DLIBPROJ -DTESTING -DTEST2 -DEERIE -DUNIX -DMARCIN -DDISK_WRITE -w -I/usr/local/include

OUTPUT_BIN = mspa_macOS_Intel

# Removed the lerc .a file from the static array
STATIC_LIBS = \
	/usr/local/opt/libtiff/lib/libtiff.a \
	/usr/local/opt/zstd/lib/libzstd.a \
	/usr/local/opt/xz/lib/liblzma.a \
	/usr/local/opt/libpng/lib/libpng.a \
	/usr/local/opt/jpeg-turbo/lib/libjpeg.a \
	/usr/local/opt/jbigkit/lib/libjbig.a \
	/usr/local/opt/webp/lib/libwebp.a \
	/usr/local/opt/webp/lib/libsharpyuv.a \
	/usr/local/Cellar/gcc/16.2.0/lib/gcc/current/libgomp.a

fsp: $(OBJ_FSP) libmiallib_mspa.a
	# Added -llerc alongside the other dynamic flags
	$(CC) -O2 -fopenmp -static-libgcc -o fsp $(OBJ_FSP) \
		-Wl,-force_load,libmiallib_mspa.a \
		-L/usr/local/lib \
		$(STATIC_LIBS) \
		-ldeflate -llerc -lgsl -lgslcblas -lz -lstdc++ -lpthread -lm -ldl
	strip fsp
	cp fsp $(OUTPUT_BIN)

%.o: %.c miallib.h
	$(COMPILE.c) -o $@ $<

clean:
	rm -f *.o fsp mspa_macOS_Intel

# IMPORTANT info and postprocessing steps to distribute mspa_mac as a standalone binary on macOS **INTEL x86**
# a) compile warnings like the following are irrelevant:
#   ld: warning: no platform load command found in '/usr/local/Cellar/jpeg-turbo/3.2.0/lib/libjpeg.a[128](jidctint-avx2.asm.o)', assuming: macOS
#
# b) terminal cmds to change the paths inside mspa_mac to @executable_path:
#   install_name_tool -change /usr/local/opt/libdeflate/lib/libdeflate.0.dylib @executable_path/libdeflate.0.dylib mspa_mac
#   install_name_tool -change /usr/local/opt/liblerc/lib/libLerc.4.dylib @executable_path/libLerc.4.dylib mspa_mac
#   install_name_tool -change /usr/local/opt/gsl/lib/libgsl.28.dylib @executable_path/libgsl.28.dylib mspa_mac
#   install_name_tool -change /usr/local/opt/gsl/lib/libgslcblas.0.dylib @executable_path/libgslcblas.0.dylib mspa_mac
#
# If you rerun otool -L mspa_mac after these modifications, the paths should now display the @executable_path/ prefix.
#
# c) copy the exact matching versioned .dylib files from your Homebrew folder into your distribution folder:
#   cp /usr/local/opt/libdeflate/lib/libdeflate.0.dylib .
#   cp /usr/local/opt/liblerc/lib/libLerc.4.dylib .
#   cp /usr/local/opt/gsl/lib/libgsl.28.dylib .
#   cp /usr/local/opt/gsl/lib/libgslcblas.0.dylib .
#
# d) The final fully portable mspa folder must have these 5 files:
#   mspa_mac
#   libdeflate.0.dylib
#   libLerc.4.dylib
#   libgsl.28.dylib
#   libgslcblas.0.dylib
