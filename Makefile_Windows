# ---------------------------------------------------------------------------
# MSPA driver makefile - MS-Windows x86_64 (MSYS2 UCRT64, GCC)
#
# Do not run this makefile directly: use ./deploy.sh Windows, which builds
# the static library libmiallib_mspa.a (in mial-master/core/c) first.
#
# CPU portability: -mtune=generic only affects instruction scheduling; no
# CPU specific instruction set is enabled, so the binary runs on any x86_64
# CPU (Intel or AMD).
# ---------------------------------------------------------------------------

OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

CC = gcc

CFLAGS = -std=c99 -O2 -m64 -mtune=generic -Wall -fopenmp \
         -DFSP -DOPENMP -DNO_BUF

LDFLAGS = -s -static -static-libgcc -static-libstdc++ -fopenmp \
          -Wl,--stack,16777216

LDLIBS = libmiallib_mspa.a \
         -ltiff -lpng -lwebp -ljpeg -ljbig -lLerc -lsharpyuv \
         -ldeflate -lz -lzstd -llzma \
         -lgomp -lstdc++ -lm

# System commands (native Windows shell vs MSYS2/Git Bash)
RM = rm -f
CP = cp
EXE =

ifeq ($(OS),Windows_NT)
    EXE = .exe
    ifeq ($(findstring cmd.exe,$(SHELL)),cmd.exe)
        RM = del /Q /F
        CP = copy /Y
    else ifeq ($(findstring powershell,$(SHELL)),powershell)
        RM = Remove-Item -Force
        CP = Copy-Item -Force
    else
        RM = rm -f
        CP = cp
    endif
endif

fsp$(EXE): $(OBJ_FSP) libmiallib_mspa.a
	-$(RM) fsp$(EXE) mspa_win64$(EXE)
	$(CC) $(LDFLAGS) -o fsp$(EXE) $(OBJ_FSP) $(LDLIBS)
	$(CP) fsp$(EXE) mspa_win64$(EXE)

%.o: %.c miallib.h op.h mia_parse.h frag.h
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	-$(RM) *.o fsp$(EXE) mspa_win64$(EXE)

.PHONY: clean
