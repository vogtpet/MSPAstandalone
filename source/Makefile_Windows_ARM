# ---------------------------------------------------------------------------
# MSPA driver makefile - MS-Windows aarch64 / ARM64 (MSYS2 CLANGARM64)
#
# Do not run this makefile directly: use ./source/deploy.sh Windows_ARM, which
# builds the static library libmiallib_mspa.a (in mial-master/core/c) first.
#
# CPU portability: no -march / -march=native is used, so the binary runs on
# any ARMv8-A (aarch64) Windows CPU.
# ---------------------------------------------------------------------------

OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

MIALINC = mial-master/core/c

CC = gcc
LD = g++

CFLAGS = -std=c99 -O2 -Wall -fopenmp \
         -DFSP -DOPENMP -DNO_BUF -I$(MIALINC)

LDFLAGS = -s -static -fopenmp -Wl,--stack,16777216

LDLIBS = libmiallib_mspa.a \
         -ltiff -lpng -lwebp -ljpeg -ljbig -lLerc -lsharpyuv \
         -ldeflate -lz -lzstd -llzma \
         -lomp -lc++ -lm

# System commands (native Windows shell vs MSYS2/Git Bash)
RM = rm -f
CP = cp
EXE =

ifeq ($(OS),Windows_NT)
    EXE = .exe
    ifeq ($(findstring cmd.exe,$(SHELL)),cmd.exe)
        RM = del /Q /F
        CP = copy /Y
    else ifeq ($(findstring powershell,$(SHELL)),powershell)
        RM = Remove-Item -Force
        CP = Copy-Item -Force
    else
        RM = rm -f
        CP = cp
    endif
endif

fsp$(EXE): $(OBJ_FSP) libmiallib_mspa.a
	-$(RM) fsp$(EXE) mspa_win64_ARM$(EXE)
	$(LD) $(LDFLAGS) -o fsp$(EXE) $(OBJ_FSP) $(LDLIBS)
	$(CP) fsp$(EXE) mspa_win64_ARM$(EXE)

%.o: %.c $(MIALINC)/miallib.h $(MIALINC)/mialtypes.h \
       $(MIALINC)/config_miallib.h $(MIALINC)/op.h mia_parse.h frag.h
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	-$(RM) *.o fsp$(EXE) mspa_win64_ARM$(EXE)

.PHONY: clean
