# ---------------------------------------------------------------------------
# MSPA driver makefile - macOS aarch64 / Apple Silicon (Homebrew GCC)
#
# Do not run this makefile directly: use ./source/deploy.sh macOS_ARM, which builds
# the static library libmiallib_mspa.a (in mial-master/core/c) first and
# bundles the two remaining dynamic libraries with install_name_tool.
#
# CPU portability: no -march / -march=native is used, so the binary runs on
# every Apple Silicon CPU.
#
# The macOS binary is an aarch64 binary for macOS 11 or later. The minimum
# version is controlled by MACOSX_DEPLOYMENT_TARGET (default: 11.0) and is
# applied to the compiler and linker below. deploy.sh prints the effective
# minimum version of the finished binary.
# ---------------------------------------------------------------------------

BREW_PREFIX := $(shell brew --prefix 2>/dev/null)

# Minimum macOS version of the resulting binary.
MACOSX_MIN ?= $(MACOSX_DEPLOYMENT_TARGET)
ifeq ($(strip $(MACOSX_MIN)),)
MACOSX_MIN := 11.0
endif
export MACOSX_DEPLOYMENT_TARGET := $(MACOSX_MIN)

OBJ_FSP = corridor_lightmemt.o frag.o mia_parse.o

MIALINC = mial-master/core/c

# Use the installed Homebrew GCC. The major version is detected at build time;
# override with `make CC=...` or through source/deploy.sh / MSPA_CC.
ifeq ($(origin CC),default)
    GCC_MAJOR := $(shell brew list --versions gcc 2>/dev/null | awk '{print $$2}' | cut -d. -f1)
    CC = $(if $(GCC_MAJOR),gcc-$(GCC_MAJOR),gcc-16)
endif

CFLAGS = -std=c99 -O2 -Wall -fopenmp \
         -mmacosx-version-min=$(MACOSX_MIN) \
         -DFSP -DOPENMP -DNO_BUF -I$(MIALINC) \
         -I$(BREW_PREFIX)/include

OUTPUT_BIN = mspa_macOS_ARM

GOMP_LIB = $(BREW_PREFIX)/opt/gcc/lib/gcc/current/libgomp.a

# Codec libraries. CI can point these at static builds (MSPA_DEFLATE_A,
# MSPA_LERC_A), so that no Homebrew dylib with a newer deployment target ends
# up in the bundle. The defaults use the Homebrew shared libraries.
DEFLATE_LINK = -ldeflate
ifneq ($(strip $(MSPA_DEFLATE_A)),)
DEFLATE_LINK = $(MSPA_DEFLATE_A)
endif

LERC_LINK = -lLerc
ifneq ($(strip $(MSPA_LERC_A)),)
LERC_LINK = $(MSPA_LERC_A)
endif

# Static libraries: only the libraries needed by MSPA (libtiff and its
# dependencies). They are given with their full path so that no version
# specific Homebrew symlink is required.
STATIC_LIBS = \
	$(BREW_PREFIX)/opt/libtiff/lib/libtiff.a \
	$(BREW_PREFIX)/opt/zstd/lib/libzstd.a \
	$(BREW_PREFIX)/opt/xz/lib/liblzma.a \
	$(BREW_PREFIX)/opt/libpng/lib/libpng.a \
	$(BREW_PREFIX)/opt/jpeg-turbo/lib/libjpeg.a \
	$(BREW_PREFIX)/opt/jbigkit/lib/libjbig.a \
	$(BREW_PREFIX)/opt/webp/lib/libwebp.a \
	$(BREW_PREFIX)/opt/webp/lib/libsharpyuv.a \
	$(GOMP_LIB)

fsp: $(OBJ_FSP) libmiallib_mspa.a
	@missing=""; for f in $(STATIC_LIBS); do \
	  [ -f "$$f" ] || missing="$$missing $$f"; done; \
	if [ -n "$$missing" ]; then \
	  echo "ERROR: missing libraries:$$missing"; \
	  echo "Install them with:"; \
	  echo "  brew install gcc liblerc libdeflate libtiff jpeg-turbo libpng webp jbigkit zstd xz"; \
	  exit 1; fi
	$(CC) -O2 -fopenmp -static-libgcc -static-libstdc++ \
		-mmacosx-version-min=$(MACOSX_MIN) -o fsp $(OBJ_FSP) \
		-Wl,-force_load,libmiallib_mspa.a \
		-L$(BREW_PREFIX)/lib \
		$(STATIC_LIBS) \
		$(DEFLATE_LINK) $(LERC_LINK) -lz -lstdc++ -lpthread -lm -ldl
	strip fsp
	cp fsp $(OUTPUT_BIN)

%.o: %.c $(MIALINC)/miallib.h $(MIALINC)/mialtypes.h \
       $(MIALINC)/config_miallib.h $(MIALINC)/op.h mia_parse.h frag.h
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	-rm -f *.o fsp $(OUTPUT_BIN)

.PHONY: clean
